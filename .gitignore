# Dependencies
node_modules/

# Build output — regenerated by @wordpress/build on every build.
# The release workflow builds fresh and ships it inside the zip artifact.
build/

# wp-env local state — lives in ~/.wp-env/<hash>/ on the host anyway,
# this line is here in case anything leaks into the project dir.
.wp-env/

# macOS
.DS_Store

# Editors
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Test coverage
coverage/
.nyc_output/

# Misc
.cache/
dist/
tmp/
*.tmp
.mount-probe-*

# Stale vitest/rolldown transpile artifacts (see memory: vitest-node-gotcha)
packages/*/build/
